{
  "name": "cadence",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @cadence/web dev",
    "build": "pnpm --filter @cadence/web build",
    "start": "pnpm --filter @cadence/web start",
    "lint": "eslint apps/web packages tests",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write \"apps/web/**/*.{js,mjs,ts,tsx,css,json}\" \"packages/**/*.{ts,mjs,json}\" \"eslint.config.mjs\" \"package.json\" \"pnpm-workspace.yaml\" \".github/workflows/privacy-baseline.yml\" \"tests/**/*.mjs\"",
    "format:check": "prettier --check \"apps/web/**/*.{js,mjs,ts,tsx,css,json}\" \"packages/**/*.{ts,mjs,json}\" \"eslint.config.mjs\" \"package.json\" \"pnpm-workspace.yaml\" \".github/workflows/privacy-baseline.yml\" \"tests/**/*.mjs\""
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.0",
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0"
  }
}
